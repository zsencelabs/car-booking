# Where the dropoff API (car-booking-backend) runs. Server-side only.
API_URL=http://localhost:4000
# Same value as the API's PROXY_SECRET, so the API rate-limits each visitor
# rather than the whole website. Server-side only.
API_PROXY_SECRET=

# Public Mapbox token for address search (https://account.mapbox.com/access-tokens/).
# Restrict it to your site's URLs in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=
